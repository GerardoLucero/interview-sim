generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id         String   @id @default(cuid())
  type       String
  level      String
  role       String
  messages   Json     @default("[]")
  evaluation Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
